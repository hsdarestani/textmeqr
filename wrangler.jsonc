{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "textmeqr",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-24",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "textmeqr",
      "database_id": "8fbe9cca-e8e1-4365-94e5-5df27a7f29f7",
      "migrations_dir": "migrations"
    }
  ],
  "routes": [
    {
      "pattern": "textmeqr.smarbiz.sbs",
      "custom_domain": true
    }
  ],
  "triggers": {
    "crons": [
      "0 3 * * *"
    ]
  }
}
